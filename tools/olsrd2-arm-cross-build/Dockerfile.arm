FROM debian:buster

COPY ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

RUN printf '%s\n' \
        'deb https://archive.debian.org/debian buster main' \
        'deb https://archive.debian.org/debian-security buster/updates main' \
        > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        gcc-arm-linux-gnueabihf libc6-dev-armhf-cross binutils-arm-linux-gnueabihf \
        cmake make git file ca-certificates \
    && rm -rf /var/lib/apt/lists/*
